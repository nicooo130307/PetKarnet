<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true"
    tools:context=".PerfilVeterinario">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Bienvenido, Doctor!"
            android:textAlignment="center"
            android:textColor="@color/negrito"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registra los datos de tu clínica o consultorio"
            android:textAlignment="center"
            android:textColor="#666666"
            android:textSize="16sp"
            android:layout_marginBottom="32dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_foto_vet"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@color/Azulito"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerInside"
            app:shapeAppearanceOverlay="@style/EstiloFotoCircular"
            app:strokeColor="@color/AzulOscuro"
            app:strokeWidth="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Sube tu foto o logo de la clínica"
            android:textColor="@color/negrito"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- Campos de texto (Nombre, Cédula, Teléfono, Dirección) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_nombre_clinica"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Nombre de la Clínica"
            app:boxStrokeColor="@color/Azulito">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_nombre_clinica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_cedula"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Cédula Profesional"
            app:boxStrokeColor="@color/Azulito">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_cedula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_telefono_clinica"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Teléfono de Contacto"
            app:boxStrokeColor="@color/Azulito">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_telefono_clinica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_direccion_clinica"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Dirección Completa"
            app:boxStrokeColor="@color/Azulito">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_direccion_clinica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SECCIÓN DE HORARIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Horario de atención"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/negrito"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_horario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="24dp" />

        <!-- Cuadro de información -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F3F4F6"
            android:padding="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="20sp"
                android:layout_marginEnd="8dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tu Cédula Profesional será verificada por nuestro equipo por seguridad."
                android:textColor="#555555"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_guardar_clinica"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Comenzar a usar PetKarnet"
            android:textColor="@color/negrito"
            app:cornerRadius="50dp"
            app:backgroundTint="@color/amarillo" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>