<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Blanquitote">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Editar Carnet"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/negrito"
                android:layout_marginTop="32dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/Blanquito"
                app:cardCornerRadius="4dp"
                app:cardElevation="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:background="@color/Azulito" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INFORMACIÓN DE LA MASCOTA"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/Azulito"
                            android:layout_marginBottom="24dp"/>

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginBottom="24dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_foto_mascota_editar"
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:background="#E0E0E0"
                                android:padding="4dp"
                                android:src="@drawable/ic_huella"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/EstiloFotoCircular"
                                app:strokeColor="@color/Azulito"
                                app:strokeWidth="4dp" />

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/fab_cambiar_foto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:src="@android:drawable/ic_menu_edit"
                                app:fabCustomSize="36dp"
                                app:tint="@color/negrito"
                                app:backgroundTint="@color/amarillo"
                                app:elevation="2dp"
                                android:layout_marginEnd="-5dp"
                                android:layout_marginBottom="-5dp"/>
                        </FrameLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Nombre"
                            app:boxStrokeColor="@color/Azulito"
                            app:hintTextColor="@color/negrito">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_nombre_mascota_editar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/negrito"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Especie:"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/negrito"
                            android:layout_marginBottom="8dp"/>

                        <RadioGroup
                            android:id="@+id/rg_especie_editar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <RadioButton
                                android:id="@+id/rb_perro_editar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perro"
                                app:buttonTint="@color/Azulito"/>

                            <RadioButton
                                android:id="@+id/rb_gato_editar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gato"
                                android:layout_marginStart="24dp"
                                app:buttonTint="@color/Azulito"/>
                        </RadioGroup>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Fecha de Nacimiento"
                            app:boxStrokeColor="@color/Azulito"
                            app:hintTextColor="@color/negrito">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_edad_mascota_editar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/negrito"
                                android:textSize="18sp"
                                android:focusable="false"
                                android:clickable="true"/>
                        </com.google.android.material.textfield.TextInputLayout>



                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Raza"
                            app:boxStrokeColor="@color/Azulito"
                            app:hintTextColor="@color/negrito">

                            <AutoCompleteTextView
                                android:id="@+id/et_raza_mascota_editar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="@color/negrito"
                                android:textSize="18sp"
                                android:popupBackground="@color/Blanquito"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_marginBottom="16dp"
                                android:hint="Sexo"
                                app:boxStrokeColor="@color/Azulito"
                                app:hintTextColor="@color/negrito">

                                <AutoCompleteTextView
                                    android:id="@+id/et_sexo_mascota_editar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:textColor="@color/negrito"
                                    android:textSize="18sp"
                                    android:popupBackground="@android:color/white"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginBottom="16dp"
                                android:hint="Peso (kg)"
                                app:boxStrokeColor="@color/Azulito"
                                app:hintTextColor="@color/negrito">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_peso_mascota_editar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:textColor="@color/negrito"
                                    android:textSize="18sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/Blanquito"
                app:cardCornerRadius="4dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:background="@color/amarillo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DATOS DE CONTACTO"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/amarillo"
                            android:layout_marginBottom="24dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Teléfono de contacto"
                            app:boxStrokeColor="@color/Azulito"
                            app:hintTextColor="@color/negrito">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_telefono_editar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/negrito"
                                android:textSize="18sp"
                                android:inputType="phone" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Dirección"
                            app:boxStrokeColor="@color/Azulito"
                            app:hintTextColor="@color/negrito">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_direccion_editar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/negrito"
                                android:textSize="18sp"
                                android:inputType="textPostalAddress" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_guardar_cambios_carnet"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Guardar Cambios"
                android:textSize="18sp"
                android:textColor="@color/negritoBotones"
                app:cornerRadius="50dp"
                app:backgroundTint="@color/amarillo"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_loading_screen" />

</androidx.constraintlayout.widget.ConstraintLayout>