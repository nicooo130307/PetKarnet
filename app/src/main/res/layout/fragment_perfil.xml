<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- NUEVO: FrameLayout para encimar el botón sobre la foto -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_foto_perfil"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="#E0E0E0"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_camera"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/EstiloFotoCircular"
                app:strokeColor="@color/Azulito"
                app:strokeWidth="4dp" />

            <!-- El lapicito de editar -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_editar_foto_perfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:src="@android:drawable/ic_menu_edit"
                app:fabCustomSize="36dp"
                app:tint="@color/negrito"
                app:backgroundTint="@color/amarillo"
                app:elevation="2dp"
                android:layout_marginEnd="-4dp"
                android:layout_marginBottom="-4dp"/>
        </FrameLayout>


        <TextView
            android:id="@+id/tv_nombre_usuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nicolas"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/negrito"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tv_rol_usuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dueño Propietario"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp"/>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/opcion_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👤 Mi Información"
                    android:textSize="18sp"
                    android:textColor="@color/negrito"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

                <TextView
                    android:id="@+id/opcion_mascotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🐾 Mis Mascotas"
                    android:textSize="18sp"
                    android:textColor="@color/negrito"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/opcion_acerca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ Acerca de PetKarnet"
                    android:textSize="18sp"
                    android:textColor="@color/negrito"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>



                <TextView
                    android:id="@+id/opcion_terminos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📜 Términos y Condiciones"
                    android:textSize="18sp"
                    android:textColor="@color/negrito"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>

                <TextView
                    android:id="@+id/opcion_configuracion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Configuración"
                    android:textSize="18sp"
                    android:textColor="@color/negrito"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cerrar_sesion"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Cerrar Sesión"
            android:textColor="#D32F2F"
            app:backgroundTint="#FFEBEE"
            app:strokeColor="#D32F2F"
            app:strokeWidth="1dp"
            app:cornerRadius="50dp"
            android:layout_marginBottom="24dp"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>