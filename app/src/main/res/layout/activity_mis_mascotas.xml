<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Blanquitote">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis Mascotas"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/negrito"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"/>



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_mis_mascotas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />
        <TextView
            android:id="@+id/tv_sin_mascotas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_weight="1"
            android:text="Aún no tienes mascotas registradas.\n¡Toca el botón amarillo para agregar una!"
            android:textColor="#999999"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_agregar_mascota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="48dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/amarillo"
        app:tint="@color/negritoBotones"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <include layout="@layout/layout_loading_screen" />

</androidx.constraintlayout.widget.ConstraintLayout>