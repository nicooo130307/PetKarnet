<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E0E0E0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalles de la Cita"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/negrito"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_bs_mascota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🐾 Mascota: "
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_bs_veterinario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👨‍⚕️ Veterinario: "
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_bs_fecha_hora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅 Fecha y Hora: "
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_bs_motivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🩺 Motivo: "
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_bs_cancelar_cita"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Cancelar Cita"
        app:backgroundTint="#FFEBEE"
        android:textColor="#D32F2F"
        app:strokeColor="#D32F2F"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp"/>

</LinearLayout>